especialidad_medica ||--|{ hospital_especialidad_medica : "id_especialidad_medica"
especialidad_medica ||--o{ sala : "id_especialidad_medica"
especialidad_medica ||--o{ sesion_atencion_medica : "id_especialidad_medica"
gestor_de_cola ||--o{ consulta_medica : "id_gestor_de_cola"
gestor_de_cola ||--o{ entrada_cola : "id_gestor_de_cola"
hospital ||--o{ asignacion_medico_hospital : "id_hospital"
