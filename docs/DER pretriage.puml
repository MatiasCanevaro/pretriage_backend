invitacion_hospital ||--|{ invitacion_hospital_especialidad : "invitacion_id"
invitacion_hospital ||--|{ invitacion_hospital_rol : "invitacion_id"
medico ||--o{ asignacion_medico_hospital : "id_medico"
medico ||--o{ consulta_medica : "id_medico"
medico ||--|{ credencial_profesional : "medico_id"
medico ||--|{ revision_prioridad_consulta : "id_medico"
medico ||--o{ sesion_atencion_medica : "id_medico"
membresia_hospital ||--|{ membresia_hospital_rol : "membresia_id"
obra_social ||--o{ credencial : "id_obra_social"
paciente ||--o| chat : "paciente_id"
paciente ||--o{ consulta_medica : "id_paciente"
paciente ||--o{ credencial : "id_paciente"
paciente ||--o{ estudio_clinico : "id_paciente"
paciente ||--o{ mensaje : "paciente_id"
recepcionista ||--|{ sesion_recepcion : "id_recepcionista"
sala ||--o{ consulta_medica : "id_sala"
sala ||--o{ sesion_atencion_medica : "id_sala"
sesion_atencion_medica ||--|{ atencion_medica : "id_sesion_atencion_medica"
sesion_recepcion ||--|{ admision_recepcion : "id_sesion_recepcion"
usuario_auth ||--|{ auditoria_hospital : "actor_id"
usuario_auth ||--|{ cambio_contrasenia_token : "id_usuario"
