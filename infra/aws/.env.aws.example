# Copy to /opt/pretriage/.env.aws and chmod 600. Never commit the filled file.
# Compose: docker compose --env-file .env.aws -f compose.aws.yaml up -d
BACKEND_IMAGE=REPLACE_WITH_ECR_URI:demo-YYYYMMDD
API_DOMAIN=api.pretriage.com.ar
POSTGRES_DB=pretriage_demo
POSTGRES_USER=pretriage
POSTGRES_PASSWORD=REPLACE_WITH_NEW_RANDOM_PASSWORD

AWS_REGION=us-east-1
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=REPLACE_WITH_STACK_OUTPUT
# No AWS access keys: the backend uses its EC2 role through IMDSv2.
AUTH0_ISSUER_URI=https://REPLACE_WITH_TENANT/
AUTH0_BASE_PATH=https://REPLACE_WITH_TENANT
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_SCOPE=
AUTH0_APP_CLIENT_ID=
PRETRIAGE_FRONTEND_BASE_URL=https://app.pretriage.com.ar
PRETRIAGE_VOZ_ORIGENES=https://app.pretriage.com.ar
PRETRIAGE_CORS_ALLOWED_ORIGINS=https://app.pretriage.com.ar
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=models/gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_LANGUAGE=es-US
GOOGLE_MAPS_API_KEY=

# Local mail mode exposes invitation/reset links in application logs. Use only
# synthetic demo identities and keep SSM/log access private, or configure SMTP.
PRETRIAGE_INVITATIONS_EMAIL_MODE=local
PRETRIAGE_CAMBIO_EMAIL_MODE=local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
